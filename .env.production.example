# Public endpoints compiled into the Web build and accepted by API CORS.
PUBLIC_API_URL=https://feedback-api.example.com
PUBLIC_WEB_URL=https://feedback.example.com
PUBLIC_ADMIN_URL=https://feedback-admin.example.com
CORS_ORIGINS=https://flutter-web.example.com

# Loopback-only ports for a single-host deployment. Put a TLS reverse proxy
# in front of API, Web, and Admin. Do not expose the MinIO console publicly.
API_PORT=4100
WEB_PORT=3000
ADMIN_PORT=8848
MINIO_CONSOLE_PORT=9001

# Stateful services. Use long, unique values in production.
POSTGRES_DB=feedback_agent
POSTGRES_USER=feedback_agent
POSTGRES_PASSWORD=replace-with-a-long-database-password
REDIS_PASSWORD=replace-with-a-long-redis-password
MINIO_ROOT_USER=feedback_agent
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
S3_BUCKET=feedback-agent
S3_REGION=us-east-1

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-secret

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Used only by the explicit bootstrap seed command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_APP_SLUG=demo

# OpenAI-compatible chat model. Empty key enables deterministic local fallback.
CHAT_PROVIDER_NAME=deepseek
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

# Optional global OpenAI-compatible embeddings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
