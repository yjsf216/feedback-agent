NODE_ENV=development
API_PORT=4100
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:8848

DATABASE_URL=postgresql://feedback_agent:feedback_agent@localhost:5432/feedback_agent?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=feedback-agent
S3_ACCESS_KEY=feedback_agent
S3_SECRET_KEY=feedback_agent_local
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-start

CHAT_PROVIDER_NAME=deepseek
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=feedback@example.com
