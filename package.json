{
  "name": "feedback-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-app AI support and feedback intelligence platform.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter './apps/*' dev",
    "build:packages": "pnpm --filter './packages/*' build",
    "dev:api": "pnpm --filter @feedback-agent/api dev",
    "dev:worker": "pnpm --filter @feedback-agent/worker dev",
    "dev:web": "pnpm --filter @feedback-agent/web dev",
    "dev:admin": "pnpm --filter @feedback-agent/admin dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "pnpm -r --if-present format:check",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @feedback-agent/database generate",
    "db:migrate": "pnpm --filter @feedback-agent/database migrate:dev",
    "db:seed": "pnpm --filter @feedback-agent/database seed",
    "db:studio": "pnpm --filter @feedback-agent/database studio",
    "sdk:analyze": "cd packages/flutter_sdk && fvm flutter analyze",
    "sdk:test": "cd packages/flutter_sdk && fvm flutter test"
  }
}
