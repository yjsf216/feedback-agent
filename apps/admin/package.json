{
  "name": "@feedback-agent/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feedback Agent administration console, derived from pure-admin-thin.",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "rimraf dist && vite build --mode staging",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "svgo": "svgo -f . -r",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:check": "eslint --max-warnings 0 \"{src,mock,build}/**/*.{vue,js,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "feedback-agent",
    "customer-support",
    "voice-of-customer",
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://github.com/yjsf216/feedback-agent/tree/main/apps/admin",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjsf216/feedback-agent.git"
  },
  "bugs": {
    "url": "https://github.com/yjsf216/feedback-agent/issues"
  },
  "license": "MIT",
  "author": "Feedback Agent contributors; based on pure-admin-thin by pure-admin",
  "dependencies": {
    "@feedback-agent/contracts": "workspace:*",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@pureadmin/descriptions": "^1.2.1",
    "@pureadmin/table": "^3.3.0",
    "@pureadmin/utils": "^2.6.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.7",
    "js-cookie": "^3.0.5",
    "localforage": "^1.10.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^4.1.0",
    "pinyin-pro": "^3.29.5",
    "qs": "^6.17.1",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.6",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tippy": "^6.8.0",
    "vue-types": "^7.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@iconify/json": "^2.2.550",
    "@iconify/vue": "5.0.4",
    "@tailwindcss/vite": "^4.1.16",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.14.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "boxen": "^9.0.0",
    "code-inspector-plugin": "^2.0.9",
    "cssnano": "^9.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "gradient-string": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-load-config": "^6.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.107.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-fake-server": "^2.2.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-router-warn": "^3.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue-demi": "^0.14.10",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "are-we-there-yet": "*",
      "sourcemap-codec": "*",
      "lodash.isequal": "*",
      "domexception": "*",
      "w3c-hr-time": "*",
      "inflight": "*",
      "npmlog": "*",
      "rimraf": "*",
      "stable": "*",
      "gauge": "*",
      "abab": "*",
      "glob": "*"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "es5-ext",
      "esbuild",
      "typeit",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide"
    ]
  }
}
