{
  "name": "@feedback-agent/database",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Prisma schema, migrations, and database client for Feedback Agent.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "generated", "prisma"],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint \"{src,prisma}/**/*.ts\" --max-warnings 0",
    "format:check": "prettier --check \"{src,prisma}/**/*.ts\" && dotenv -e ../../.env.example -- prisma validate",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
